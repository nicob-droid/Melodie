<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_equalizer"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <Spinner
            android:id="@+id/preset_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:padding="12dp" />

        <TextView
            android:id="@+id/eq_unavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/eq_unavailable"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bands_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:gravity="top|center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="180dp"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/EqBandLabel"
                    android:paddingBottom="0dp"
                    android:text="+12.0" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/EqBandLabel"
                    android:paddingBottom="0dp"
                    android:text="+6.0" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/EqBandLabel"
                    android:paddingBottom="0dp"
                    android:text="0.0" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/EqBandLabel"
                    android:paddingBottom="0dp"
                    android:text="-6.0" />

                <Space
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    style="@style/EqBandLabel"
                    android:paddingBottom="0dp"
                    android:text="-12.0" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top|center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EqBandLabel"
                            android:text="@string/eq_freq_60" />

                        <com.melodie.player.ui.equalizer.VerticalSeekBar
                            android:id="@+id/band_0"
                            android:layout_width="40dp"
                            android:layout_height="180dp" />

                        <TextView
                            android:id="@+id/band_0_level"
                            style="@style/EqBandLabel"
                            android:text="0.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EqBandLabel"
                            android:text="@string/eq_freq_230" />

                        <com.melodie.player.ui.equalizer.VerticalSeekBar
                            android:id="@+id/band_1"
                            android:layout_width="40dp"
                            android:layout_height="180dp" />

                        <TextView
                            android:id="@+id/band_1_level"
                            style="@style/EqBandLabel"
                            android:text="0.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EqBandLabel"
                            android:text="@string/eq_freq_910" />

                        <com.melodie.player.ui.equalizer.VerticalSeekBar
                            android:id="@+id/band_2"
                            android:layout_width="40dp"
                            android:layout_height="180dp" />

                        <TextView
                            android:id="@+id/band_2_level"
                            style="@style/EqBandLabel"
                            android:text="0.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EqBandLabel"
                            android:text="@string/eq_freq_3600" />

                        <com.melodie.player.ui.equalizer.VerticalSeekBar
                            android:id="@+id/band_3"
                            android:layout_width="40dp"
                            android:layout_height="180dp" />

                        <TextView
                            android:id="@+id/band_3_level"
                            style="@style/EqBandLabel"
                            android:text="0.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EqBandLabel"
                            android:text="@string/eq_freq_14000" />

                        <com.melodie.player.ui.equalizer.VerticalSeekBar
                            android:id="@+id/band_4"
                            android:layout_width="40dp"
                            android:layout_height="180dp" />

                        <TextView
                            android:id="@+id/band_4_level"
                            style="@style/EqBandLabel"
                            android:text="0.0" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="6dp"
                        android:background="@color/surface_variant" />

                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            style="@style/EqBandLabel"
                            android:text="OUT" />

                        <com.melodie.player.ui.equalizer.VerticalSeekBar
                            android:id="@+id/band_master"
                            android:layout_width="40dp"
                            android:layout_height="180dp"
                            android:max="2000"
                            app:vsbThumbColor="@color/audio_cyan"
                            app:vsbTrackFillColor="@color/audio_cyan" />

                        <TextView
                            android:id="@+id/band_master_level"
                            style="@style/EqBandLabel"
                            android:text="0.0" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_bass_boost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eq_bass_boost"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp" />

        <SeekBar
            android:id="@+id/seek_bass_boost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressTint="@color/melodie_purple"
            android:thumbTint="@color/melodie_purple" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_virtualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eq_virtualizer"
            android:textColor="@color/text_primary" />

        <SeekBar
            android:id="@+id/seek_virtualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressTint="@color/melodie_purple"
            android:thumbTint="@color/melodie_purple" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_loudness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eq_loudness"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

