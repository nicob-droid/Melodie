<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/settings_eq"
            style="@style/SettingsItem"
            android:text="@string/settings_equalizer" />

        <TextView
            android:id="@+id/settings_folders"
            style="@style/SettingsItem"
            android:text="@string/settings_folders" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settings_online_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:text="@string/settings_online_cover"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

