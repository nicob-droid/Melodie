<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/settings_audio"
            style="@style/SettingsItem"
            android:text="@string/settings_audio" />

        <TextView
            android:id="@+id/settings_eq"
            style="@style/SettingsItem"
            android:text="@string/settings_equalizer" />

        <TextView
            android:id="@+id/settings_library"
            style="@style/SettingsItem"
            android:text="@string/settings_library" />

        <TextView
            android:id="@+id/settings_drive"
            style="@style/SettingsItem"
            android:text="@string/settings_drive" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settings_online_cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:text="@string/settings_online_cover"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/settings_refresh_cover"
            style="@style/SettingsItem"
            android:text="@string/settings_refresh_cover" />

        <TextView
            android:id="@+id/settings_cache"
            style="@style/SettingsItem"
            android:text="@string/settings_cache" />

        <TextView
            android:id="@+id/settings_theme"
            style="@style/SettingsItem"
            android:text="@string/settings_theme" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

